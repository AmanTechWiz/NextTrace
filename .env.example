# Copy to .env (git-ignored) and fill in. Every line is optional.

# Only for the PR bot's written review. No key means the rule-based review.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model, and a local cap for free-tier keys (unset means no cap)
# NEXTTRACE_GEMINI_MODEL=gemini-flash-latest
# NEXTTRACE_GEMINI_RPM=5
# NEXTTRACE_GEMINI_RPD=20

# FalkorDB connection (defaults shown; FalkorDB Cloud needs all five)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false
